<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="craft-agent"
        Arguments=""
        InstallLocation="C:\Program Files\Craft Agent\Craft Agent">
    </Installer>
    <PackageInformation
        PackageName="Craft Agent"
        PackageDisplayName="Craft Agent"
        PublisherName="CN=Craft Agent"
        PublisherDisplayName="Craft Agent"
        Version="0.1.0.0"
        PackageDescription="AI co-editing hub for the Craft suite">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="ai.storyteller.craftagent"
                Description="AI co-editing hub for the Craft suite"
                DisplayName="Craft Agent"
                ExecutableName="craft-agent"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Craft Agent</DisplayName>
            <PublisherDisplayName>Craft Agent</PublisherDisplayName>
            <Description>AI co-editing hub for the Craft suite</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="craft-agent.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
